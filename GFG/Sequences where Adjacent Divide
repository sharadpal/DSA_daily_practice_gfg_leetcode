Examples:

Input: n = 3, m = 3
Output : 17
Explanation: The possible arrays are [1, 1, 1], [1, 1, 2], [1, 1, 3], [1, 2, 1], [1, 2, 2], [1, 3, 1], [1, 3, 3], [2, 1, 1],
[2, 1, 2], [2, 1, 3], [2, 2, 1], [2, 2, 2], [3, 1, 1], [3, 1, 2], [3, 1, 3], [3, 3, 1] and [3, 3, 3].
-------------------------------------------------------

class Solution {
    int dp[][];
    public int count(int n, int m) {
        // code here
        if(n==1) return m;
        int ans=0;
        dp=new int[n+1][m+1];
        for(int i=0;i<n+1;i++){
            for(int j=0;j<m+1;j++){
                dp[i][j]=-1;
            }
        }
        for(int first=1;first<=m;first++){
            ans+=solve(n,m,1,first);
        }
        return ans;
    }
    
    int solve(int n, int m, int idx, int prev){
        if(idx==n) return 1;
        if(dp[idx][prev]!=-1){
            return dp[idx][prev];
        }
        
        int ans=0;
        for(int curr=1;curr<=m;curr++){
            if(curr%prev==0 || prev%curr==0){
                ans+=solve(n,m,idx+1,curr);
            }
        }
        return dp[idx][prev]=ans;
    }
}
