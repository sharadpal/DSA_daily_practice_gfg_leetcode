Examples :

Input: s = "socks"
Output: 3
Explanation: There are 3 characters between the two occurrences of 's'.
-------------------------

class Solution {
    public int maxCharGap(String s) {
        // code here
        int ans=-1;
        for(int i=0;i<s.length();i++){
            char c= s.charAt(i);
            ans=Math.max(ans, s.lastIndexOf(c)-s.indexOf(c)-1);
        }
        return ans;
    }
};
