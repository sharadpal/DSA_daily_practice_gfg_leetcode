Examples:

Input: grid[][] = [[3, 2], [1, 3]]
Output: [2, 8]
Explanation:
There are 2 valid paths from [0, 0] to [1, 1]:
Path 1: [0, 0] -> [0, 1] -> [1, 1], values 3 + 2 + 3 = 8
Path 2: [0,0] -> [1, 0] -> [1, 1], values 3 + 1 + 3 = 7
The maximum Adventure among these is 8, so the output is [2, 8].
---------------------------------------------------------------------

class Solution {
	public ArrayList<Integer> findWays(int[][] grid) {
		
		int n = grid.length;
		int mod = 1000000007;
		
		long[][] ways = new long[n][n];
		int[][] maxAdv = new int[n][n];
		
		// Start cell
		ways[0][0] = 1;
		maxAdv[0][0] = grid[0][0];
		
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < n; j++) {
				
				if (i == 0 && j == 0) {
					continue;
				}
				
				// Come from TOP
				if (i > 0 &&
				ways[i - 1][j] > 0 &&
				(grid[i - 1][j] == 2 || grid[i - 1][j] == 3)) {
					
					ways[i][j] =
					(ways[i][j] + ways[i - 1][j]) % mod;
					
					maxAdv[i][j] = Math.max(
					maxAdv[i][j],
					maxAdv[i - 1][j] + grid[i][j]
					);
				}
				
				// Come from LEFT
				if (j > 0 &&
				ways[i][j - 1] > 0 &&
				(grid[i][j - 1] == 1 || grid[i][j - 1] == 3)) {
					
					ways[i][j] =
					(ways[i][j] + ways[i][j - 1]) % mod;
					
					maxAdv[i][j] = Math.max(
					maxAdv[i][j],
					maxAdv[i][j - 1] + grid[i][j]
					);
				}
			}
		}
		
		ArrayList<Integer> result = new ArrayList<>();
		
		int totalPaths = (int) ways[n - 1][n - 1];
		
		// If destination is unreachable, Adventure must also be 0
		int maxAdventure = totalPaths == 0
		? 0
		: maxAdv[n - 1][n - 1];
		
		result.add(totalPaths);
		result.add(maxAdventure);
		
		return result;
	}
}
