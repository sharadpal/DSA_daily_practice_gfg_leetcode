Examples:

Input: arr[] = [1, 2]
Output: [[2, 1, 1], [3, 1, 2], [3, 2, 1]]
Explanation: The links are 2 → 1 and 3 → 2. User 2 can reach user 1 in 1 link. User 3 can reach user 1 in 2 links.
User 3 can reach user 2 in 1 link.
------------------------------------------------------------------------------

class Solution {
	
	public ArrayList<ArrayList<Integer>> socialNetwork(int[] arr) {
		// code here
		int n = arr.length + 1;
		int[][] dist = new int[n + 1][n + 1];
		ArrayList<ArrayList<Integer>> result = new ArrayList<>();
		for (int i = 2; i <= n; i++) {
			int friend = arr[i - 2];
			dist[i][friend] = 1;
			for (int j = 1; j < friend; j++) {
				if (dist[friend][j] > 0) {
					dist[i][j] = dist[friend][j] + 1;
				}
			}
			for (int j = 1; j < i; j++) {
				
				if (dist[i][j] > 0) {
					ArrayList<Integer> tuple = new ArrayList<>();
					tuple.add(i);	
					tuple.add(j);
					tuple.add(dist[i][j]);
					result.add(tuple);
				}
			}
		}
		return result;
	}
}
