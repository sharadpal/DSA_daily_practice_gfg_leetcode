Input: n = 7
Output: 5
Explanation: 0 + 1 = 1 --> 1 + 1 = 2 --> 1 + 2 = 3 --> 3 * 2 = 6 --> 6 + 1 = 7.
--------------------------------------------------------------------------------

class Solution {
    public int minOperation(int n) {
        // code here
        if(n==0) return 0;
        int count=0;
        int num=n;
        while(num>0){
            if(num%2==0){
                num/=2;
            }
            else{
                num-=1;
            }
            count++;
        }
        return count;
        
    }
}
