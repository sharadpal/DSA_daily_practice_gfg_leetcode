Examples:

Input: root[] = [1, 2, 3]
                                
Output: 2
Explanation : Longest sequence is 1, 2. So answer for this test case is 2.
-----------------------------

class Solution {
    int ans=1;
    public int longestConsecutive(Node root) {
        // code here
        if (root == null)
            return -1;
        dfs(root, root.data - 1, 0);
        return ans == 1 ? -1 : ans;
        
    }
    
    void dfs(Node node, int prev, int len) {
        if (node == null)
            return;
        if (node.data == prev + 1)
            len++;
        else
            len = 1;
        ans = Math.max(ans, len);
        dfs(node.left, node.data, len);
        dfs(node.right, node.data, len);
    }
}
