Examples :

Input: V = 4, src = 0, edges[][] = [[0, 1, 1], [0, 2, 1], [1, 2, 5], [3, 1, 2], [3, 2, -1]]
Output: [0, 1, 6, INF]
Explanation: The longest distance of vertex 1 from 0 is 1, vertex 2 is 6 and vertex 3 is unreachable so INF.
-----------------------------------

class Solution {
	public int[] maxDistance(int V, int src, ArrayList<ArrayList<Integer>> edges) {
		// code here
		int dist[] = new int[V];
		Arrays.fill(dist, Integer.MIN_VALUE);
		dist[src] = 0;
		// prepare adj list
		ArrayList<ArrayList<int[]>> adj = new ArrayList<>();
		for (int i = 0; i<V; i++) {
			adj.add(new ArrayList<>());
		}
		for (ArrayList<Integer> e : edges) {
			int u = e.get(0), v = e.get(1), w = e.get(2);
			adj.get(u).add(new int[] {v, w});
		}
		// BFS
		
		Queue<int[]> q = new LinkedList<>();
		q.add(new int[] {src, 0});
		while (!q.isEmpty()) {
			int[] p = q.poll();
			int currNode = p[0], currW = p[1];
			if (dist[currNode] != currW)
				continue;
			for (int[] nei: adj.get(currNode)) {
				if (dist[nei[0]]< currW + nei[1]) {
					dist[nei[0]] = currW + nei[1];
					q.add(new int[] {nei[0], dist[nei[0]]});
				}
			}
		}
		return dist;
	}
}
