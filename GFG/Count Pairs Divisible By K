Examples:

Input :  arr[] = [2, 2, 1, 7, 5, 3], k = 4
Output : 5
Explanation : There are five pairs possible whose sum is divisible by '4' i.e., (2, 2), (1, 7), (7, 5), (1, 3) and (5, 3).
------------------------


class Solution {
    public int countKdivPairs(int[] arr, int k) {
        int[] freq = new int[k];
        int count = 0;

        // Count frequency of remainders
        for (int num : arr) {
            int rem = num % k;
            freq[rem]++;
        }
        // Count pairs
        for (int r = 0; r < k; r++) {
            if (freq[r] > 0) {
                int complement = (k - r) % k;

                if (r == complement) {
                    // Pairs with same remainder
                    count += (freq[r] * (freq[r] - 1)) / 2;
                } 
                else if (r < complement) {
                    // Avoid double counting
                    count += freq[r] * freq[complement];
                }
            }
        }

        return count;
    }
}
