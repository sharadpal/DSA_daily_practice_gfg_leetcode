Examples:

Input: arr[] = [1, 2, 3, -4, 5]
Output: 11
Explanation: We can get maximum sum subarray by skipping -4.
-----------------------------

class Solution {
    public int maxSumSubarray(int[] arr) {
        // code here
        int n= arr.length;
        if(n==1) return arr[0];
        int left[]=new int[n];
        int right[]= new int[n];
        
        // max subaaray of i
        left[0]=arr[0];
        int ans= arr[0];
        
        for(int i=1;i<n;i++){
            left[i]= Math.max(arr[i], arr[i]+left[i-1]);
            ans= Math.max(left[i],ans);
        }
        
        right[n-1]= arr[n-1];
        for(int i=n-2;i>=0;i--){
            right[i]=Math.max(arr[i], arr[i]+right[i+1]);
        }
        
        for(int i=1;i<n-1;i++){
            ans=Math.max(ans,left[i-1]+right[i+1]);
        }
        return ans;
    }
}
