Input: l = 4, r = 13, arr[] = [2, 3, 5, 8]
Output: 6
Explanation: The subarrays are [2, 3], [2, 3, 5], [3, 5], [5], [5, 8] and [8]. 
Therefore answer for this test case is 6.
---------------------------------------------

class Solution {
	public int countSubarray(int[] arr, int l, int r) {
		// code here
		 return solve(arr,r) - solve(arr,l-1);
		
	}
	public static int solve(int[] arr, int r) {
		int cnt = 0;
		int s = 0;
		int i = 0;
		int j = 0;
		int n = arr.length;
		
		while (j<n) {
			s += arr[j];
			
			while (s>r && i <= j) {
				s -= arr[i];
				i++;
			}
			j++;
			cnt += (j - i + 1);
		}
		
		return cnt;
	}
}
