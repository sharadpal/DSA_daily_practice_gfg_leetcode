Examples:

Input: V = 4, edges[][] = [[0, 1, 1], [0, 2, 2], [2, 3, 1], [1, 2, 1], [1, 3, 2]], src = 0, dest = 3

Output: 3
Explanation: One of the shortest paths from vertex 0 to vertex 3 is 0 -> 1 -> 3 with a total weight of 1 + 2 = 3.
Another shortest path is 0 -> 2 -> 3 with a total weight of 2 + 1 = 3.
Hence, the shortest distance from 0 to 3 is 3. 
------------------------------

class Solution {
	public int shortestPath(int V, int src, int dest, int[][] edges) {
		List<List<Integer>> graph = new ArrayList<>();
		
		for (int i = 0; i<V + edges.length; i++) {
			graph.add(new ArrayList<>());
		}
		
		int newNode = V;
		for (int[] edge: edges) {
			int u = edge[0];
			int v = edge[1];
			int w = edge[2];
			
			if (w == 1) {
				graph.get(u).add(v);
				graph.get(v).add(u);
			} else {
				graph.get(u).add(newNode);
				graph.get(newNode).add(u);
				
				graph.get(newNode).add(v);
				graph.get(v).add(newNode);
				
				newNode++;
			}
		}
		
		boolean[] visited = new boolean[newNode];
		Queue<Integer> q = new LinkedList<>();
		q.offer(src);
		visited[src] = true;
		
		int level = 0;
		while (!q.isEmpty()) {
			int size = q.size();
			while (size-- > 0) {
				int node = q.poll();
				if (node == dest) {
					return level;
				}
				for (int next:graph.get(node)) {
					if (visited[next]) {
						continue;
					}
					visited[next] = true;
					q.offer(next);
				}
			}
			level++;
		}
		return - 1;
	}
}
