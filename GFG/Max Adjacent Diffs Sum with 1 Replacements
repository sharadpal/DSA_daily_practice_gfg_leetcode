Examples:

Input: arr[] = [3, 2, 1, 4, 5]
Output: 8
Explanation: Modify the array as arr[] = [3, 1, 1, 4, 1]. 
Sum = |1-3| + |1-1| + |4-1| + |1-4| = 8, the maximum possible.
-----------------------------------------------------------------------

class Solution {
	public int maxDiffSum(int[] arr) {
		int prevOrg = 0;
		int prevOne = 0;
		
		for (int i = 1; i<arr.length; i++) {
			int prev = arr[i - 1];
			int curr = arr[i];
			
			int currentOrg = Math.max(
			prevOrg + Math.abs(curr - prev),
			prevOne + Math.abs(curr - 1)
			);
			
			int currentOne = Math.max(
			prevOrg + Math.abs(1 - prev),
			prevOne
			);
			
			prevOrg = currentOrg;
			prevOne = currentOne;
		}
		return Math.max(prevOrg, prevOne);
	}
}
