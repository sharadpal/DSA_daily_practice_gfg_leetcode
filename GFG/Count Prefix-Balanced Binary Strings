class Solution {
    public int prefixStrings(int N) {
        long MOD = 1000000007L;

        // dp[i] = Catalan number C(i)
        long[] dp = new long[N + 1];
        dp[0] = 1;
        for (int i = 1; i <= N; i++) {
            dp[i] = (dp[i - 1] * (4L * i - 2)) % MOD;
            // Modular inverse of (i + 1)
            dp[i] = (dp[i] * modInverse(i + 1, MOD)) % MOD;
        }
        return (int) dp[N];
    }

    private long modInverse(long a, long mod) {
        return power(a, mod - 2, mod);
    }

    private long power(long a, long b, long mod) {
        long result = 1;
        while (b > 0) {
            if ((b & 1) == 1) {
                result = (result * a) % mod;
            }
            a = (a * a) % mod;
            b >>= 1;
        }
        return result;
    }
}
