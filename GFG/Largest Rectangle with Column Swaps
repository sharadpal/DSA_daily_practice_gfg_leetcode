Input: mat[][] = [[0, 1, 1, 0, 0], [1, 1, 1, 0, 1], [1, 1, 1, 0, 1], [1, 1, 1, 1, 1]]
Output: 12
Explanation: After swapping the 4th and 5th columns, the largest rectangle of 1s has an area of 12.
---------------------------------------------------------------------------------------------------------

class Solution {
    public int maxArea(int[][] mat) {
        // code here
        int n = mat.length;
        int m = mat[0].length;
        int[] height = new int[m];
        int maxArea = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1) {
                    height[j]++;
                } else {
                    height[j] = 0;
                }
            }
            int[] sorted = height.clone();
            Arrays.sort(sorted);
            // Try every possible width
            for (int j = 0; j < m; j++) {
                int width = m - j;
                int h = sorted[j];

                maxArea = Math.max(maxArea, h * width);
            }
        }
        return maxArea;
    }
}
